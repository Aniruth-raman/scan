<?xml version="1.0" encoding="utf-8"?>
<!--
  Scopes the FileProvider used to open saved scans in external viewers.
  Scans are written to getApplicationDocumentsDirectory(), which on Android
  resolves to the app's private files directory (app_flutter).
-->
<paths>
    <files-path name="internal_files" path="." />
    <cache-path name="internal_cache" path="." />
    <external-files-path name="external_files" path="." />
</paths>
